[Unit]
Description=claude.ai export — retrieve
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/user/ember-research-lab/claude-cortex/scripts/export-automation/run-export.sh retrieve
StandardOutput=journal
StandardError=journal
EnvironmentFile=-%h/.cortex-consolidate.env
Environment=HOME=/home/user
Environment=PATH=/home/user/.local/share/fnm/aliases/default/bin:/home/user/.local/bin:/home/user/.cargo/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=900
