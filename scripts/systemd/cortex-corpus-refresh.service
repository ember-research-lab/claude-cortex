[Unit]
Description=Ingest a new claude.ai export zip and trigger consolidation

[Service]
Type=oneshot
ExecStart=/home/user/ember-research-lab/claude-cortex/scripts/refresh-corpus.sh
StandardOutput=journal
StandardError=journal

EnvironmentFile=-%h/.cortex-consolidate.env
Environment=HOME=/home/user
Environment=PATH=/home/user/.local/bin:/home/user/.cargo/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=1800
